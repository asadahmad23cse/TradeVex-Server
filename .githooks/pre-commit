#!/usr/bin/env sh
set -eu

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"

if [ "$branch" = "main" ]; then
  echo "WARNING: commit blocked on protected branch 'main'." >&2
  echo "Direct commit to main is forbidden. Create a feature branch and open a PR." >&2
  exit 1
fi

exit 0
